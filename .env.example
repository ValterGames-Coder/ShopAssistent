CHAT_MODEL=qwen3:4b
EMBEDDING_MODEL=embeddinggemma
MODEL_TIMEOUT_SECONDS=180
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.30
MAX_QUESTION_LENGTH=1500
USER_COOLDOWN_SECONDS=3
